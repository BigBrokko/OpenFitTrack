{
  "components": {
    "schemas": {
      "DaySummary": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/LoggedEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "The goal that applied on this day, if any."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "progress": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ProgressItem"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Keys kcal, protein_g, carbs_g, fat_g vs the goal; null without a goal.",
            "title": "Progress"
          },
          "totals": {
            "$ref": "#/components/schemas/NutrientValues"
          }
        },
        "required": [
          "date",
          "totals",
          "goal",
          "progress",
          "entries"
        ],
        "title": "DaySummary",
        "type": "object"
      },
      "DayTotals": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/NutrientValues"
          }
        },
        "required": [
          "date",
          "totals"
        ],
        "title": "DayTotals",
        "type": "object"
      },
      "FoodCandidate": {
        "properties": {
          "carbs_g": {
            "description": "Per 100 g.",
            "title": "Carbs G",
            "type": "number"
          },
          "fat_g": {
            "description": "Per 100 g.",
            "title": "Fat G",
            "type": "number"
          },
          "kcal": {
            "description": "Per 100 g.",
            "title": "Kcal",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "protein_g": {
            "description": "Per 100 g.",
            "title": "Protein G",
            "type": "number"
          },
          "score": {
            "description": "Match quality, 0-100.",
            "title": "Score",
            "type": "number"
          },
          "source": {
            "description": "Where the food came from, e.g. manual or an import name.",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "name",
          "source",
          "kcal",
          "protein_g",
          "carbs_g",
          "fat_g",
          "score"
        ],
        "title": "FoodCandidate",
        "type": "object"
      },
      "FoodSearchResult": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "description": "Best match first.",
            "items": {
              "$ref": "#/components/schemas/FoodCandidate"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "query",
          "results"
        ],
        "title": "FoodSearchResult",
        "type": "object"
      },
      "GoalInfo": {
        "properties": {
          "carbs_g": {
            "title": "Carbs G",
            "type": "number"
          },
          "fat_g": {
            "title": "Fat G",
            "type": "number"
          },
          "kcal": {
            "title": "Kcal",
            "type": "number"
          },
          "protein_g": {
            "title": "Protein G",
            "type": "number"
          },
          "target_weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Weight Kg"
          },
          "valid_from": {
            "description": "The goal applies from this date until the next one.",
            "format": "date",
            "title": "Valid From",
            "type": "string"
          }
        },
        "required": [
          "valid_from",
          "kcal",
          "protein_g",
          "carbs_g",
          "fat_g"
        ],
        "title": "GoalInfo",
        "type": "object"
      },
      "GoalsInfo": {
        "properties": {
          "current": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "The goal that applies today."
          },
          "history": {
            "description": "All goals, newest first.",
            "items": {
              "$ref": "#/components/schemas/GoalInfo"
            },
            "title": "History",
            "type": "array"
          }
        },
        "required": [
          "current",
          "history"
        ],
        "title": "GoalsInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoggedEntry": {
        "properties": {
          "amount_g": {
            "title": "Amount G",
            "type": "number"
          },
          "food": {
            "title": "Food",
            "type": "string"
          },
          "nutrients": {
            "$ref": "#/components/schemas/NutrientValues",
            "description": "For this amount, not per 100 g."
          },
          "time": {
            "description": "Local time, HH:MM.",
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "time",
          "food",
          "amount_g",
          "nutrients"
        ],
        "title": "LoggedEntry",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Me": {
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          }
        },
        "required": [
          "authenticated"
        ],
        "title": "Me",
        "type": "object"
      },
      "NutrientValues": {
        "properties": {
          "carbs_g": {
            "title": "Carbs G",
            "type": "number"
          },
          "fat_g": {
            "title": "Fat G",
            "type": "number"
          },
          "kcal": {
            "title": "Kcal",
            "type": "number"
          },
          "protein_g": {
            "title": "Protein G",
            "type": "number"
          }
        },
        "required": [
          "kcal",
          "protein_g",
          "carbs_g",
          "fat_g"
        ],
        "title": "NutrientValues",
        "type": "object"
      },
      "PeriodSummary": {
        "properties": {
          "average_per_logged_day": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutrientValues"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean over the logged days only. Unlogged days are not counted as zero."
          },
          "average_vs_goal": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/ProgressItem"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The average per logged day compared to the goal on the end date.",
            "title": "Average Vs Goal"
          },
          "daily": {
            "description": "Only days that have logged food, oldest first.",
            "items": {
              "$ref": "#/components/schemas/DayTotals"
            },
            "title": "Daily",
            "type": "array"
          },
          "days_in_period": {
            "title": "Days In Period",
            "type": "integer"
          },
          "days_logged": {
            "description": "Days with at least one logged entry.",
            "title": "Days Logged",
            "type": "integer"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "goal_on_end_date": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          }
        },
        "required": [
          "start_date",
          "end_date",
          "days_in_period",
          "days_logged",
          "daily",
          "average_per_logged_day",
          "average_vs_goal"
        ],
        "title": "PeriodSummary",
        "type": "object"
      },
      "ProgressItem": {
        "properties": {
          "eaten": {
            "title": "Eaten",
            "type": "number"
          },
          "goal": {
            "title": "Goal",
            "type": "number"
          },
          "percent": {
            "description": "Eaten as a percentage of the goal. May exceed 100.",
            "title": "Percent",
            "type": "number"
          },
          "remaining": {
            "description": "Goal minus eaten. Negative means over the goal.",
            "title": "Remaining",
            "type": "number"
          }
        },
        "required": [
          "eaten",
          "goal",
          "remaining",
          "percent"
        ],
        "title": "ProgressItem",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeightPoint": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "trend_kg": {
            "description": "Exponential moving average (half-life 7 days).",
            "title": "Trend Kg",
            "type": "number"
          },
          "weight_kg": {
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "date",
          "weight_kg",
          "trend_kg"
        ],
        "title": "WeightPoint",
        "type": "object"
      },
      "WeightTrend": {
        "properties": {
          "latest_trend_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Trend Kg"
          },
          "latest_weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Weight Kg"
          },
          "measurements_total": {
            "description": "All measurements ever logged.",
            "title": "Measurements Total",
            "type": "integer"
          },
          "points": {
            "description": "Measurements in the requested window.",
            "items": {
              "$ref": "#/components/schemas/WeightPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "target_weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "From the goal that applies today.",
            "title": "Target Weight Kg"
          },
          "trend_change_7d_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Change of the trend over the last 7 days; null without enough history.",
            "title": "Trend Change 7D Kg"
          }
        },
        "required": [
          "points",
          "measurements_total",
          "latest_weight_kg",
          "latest_trend_kg",
          "trend_change_7d_kg",
          "target_weight_kg"
        ],
        "title": "WeightTrend",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OpenFitTrack API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/day": {
      "get": {
        "description": "One day: logged food, totals, and the totals against that day's goal.",
        "operationId": "get_day_summary",
        "parameters": [
          {
            "description": "YYYY-MM-DD, default today",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD, default today",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DaySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Day Summary"
      }
    },
    "/api/foods/search": {
      "get": {
        "description": "Find foods in the database. Values are per 100 g.",
        "operationId": "search_foods",
        "parameters": [
          {
            "description": "Food name",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Food name",
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodSearchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Foods"
      }
    },
    "/api/goals": {
      "get": {
        "description": "The goal that applies today and the goal history.",
        "operationId": "get_goals",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalsInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Goals"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health"
      }
    },
    "/api/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/me": {
      "get": {
        "description": "Used by the frontend to decide between the login screen and the app.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Me"
      }
    },
    "/api/period": {
      "get": {
        "description": "Daily totals and averages over a period (at most 366 days), against the goal.",
        "operationId": "get_period_summary",
        "parameters": [
          {
            "description": "YYYY-MM-DD, default 6 days before the end date",
            "in": "query",
            "name": "start_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD, default 6 days before the end date",
              "title": "Start Date"
            }
          },
          {
            "description": "YYYY-MM-DD, default today",
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD, default today",
              "title": "End Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Period Summary"
      }
    },
    "/api/weight": {
      "get": {
        "description": "Weights with an exponential moving average trend and the 7-day change.",
        "operationId": "get_weight_trend",
        "parameters": [
          {
            "description": "How many days back",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 90,
              "description": "How many days back",
              "maximum": 730,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeightTrend"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Weight Trend"
      }
    }
  }
}
