DATABASE_URL=sqlite:///openfittrack.db

# Login for the API. Create both values with: uv run python scripts/create_credentials.py
# Keep the single quotes: the hash contains $ signs.
OFT_PASSWORD_HASH=
OFT_SESSION_SECRET=

# The session cookie only travels over HTTPS. Set to false only to test over plain http.
OFT_COOKIE_SECURE=true
